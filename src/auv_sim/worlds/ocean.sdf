<?xml version="1.0"?>
<!--
  Simple ocean: water surface at z = 0, seabed at z = -20 m.
  The AUV is spawned by the launch file (see launch/sim.launch.py).
-->
<sdf version="1.8">
  <world name="ocean">

    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>

    <!-- Water below z = 0, air above it -->
    <plugin filename="ignition-gazebo-buoyancy-system"
            name="ignition::gazebo::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
    </plugin>

    <scene>
      <ambient>0.1 0.35 0.45 1</ambient>
      <background>0.0 0.25 0.35 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.8 0.9 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- Water surface (visual only, seen from below) -->
    <model name="water_surface">
      <static>true</static>
      <link name="link">
        <visual name="surface">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.0 0.45 0.65 0.35</ambient>
            <diffuse>0.0 0.45 0.65 0.35</diffuse>
          </material>
          <transparency>0.6</transparency>
        </visual>
        <visual name="surface_underside">
          <pose>0 0 0 3.14159 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.0 0.45 0.65 0.35</ambient>
            <diffuse>0.0 0.45 0.65 0.35</diffuse>
          </material>
          <transparency>0.6</transparency>
        </visual>
      </link>
    </model>

    <!-- Seabed -->
    <model name="seabed">
      <static>true</static>
      <pose>0 0 -20 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.76 0.70 0.50 1</ambient><diffuse>0.76 0.70 0.50 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pipeline lying on the seabed along +x -->
    <model name="pipeline">
      <static>true</static>
      <pose>25 -4 -19.7 0 1.5708 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>40</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.3</radius><length>40</length></cylinder></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Rocks -->
    <model name="rock_1">
      <static>true</static>
      <pose>15 6 -18.5 0.3 0.2 0.5</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3 2.5 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3 2.5 3</size></box></geometry>
          <material><ambient>0.35 0.35 0.33 1</ambient><diffuse>0.35 0.35 0.33 1</diffuse></material></visual>
      </link>
    </model>
    <model name="rock_2">
      <static>true</static>
      <pose>30 10 -17 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><sphere><radius>3</radius></sphere></geometry></collision>
        <visual name="v"><geometry><sphere><radius>3</radius></sphere></geometry>
          <material><ambient>0.3 0.32 0.3 1</ambient><diffuse>0.3 0.32 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Gate to swim through (centre at x=20, y=0, z=-5) -->
    <model name="gate">
      <static>true</static>
      <pose>20 0 -5 0 0 0</pose>
      <link name="link">
        <collision name="left"><pose>0 1.5 -1 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>3</length></cylinder></geometry></collision>
        <visual name="left_v"><pose>0 1.5 -1 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>3</length></cylinder></geometry>
          <material><ambient>1 0.1 0.1 1</ambient><diffuse>1 0.1 0.1 1</diffuse><emissive>0.4 0 0 1</emissive></material></visual>
        <collision name="right"><pose>0 -1.5 -1 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>3</length></cylinder></geometry></collision>
        <visual name="right_v"><pose>0 -1.5 -1 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>3</length></cylinder></geometry>
          <material><ambient>0.1 1 0.1 1</ambient><diffuse>0.1 1 0.1 1</diffuse><emissive>0 0.4 0 1</emissive></material></visual>
        <collision name="top"><pose>0 0 0.5 1.5708 0 0</pose><geometry><cylinder><radius>0.08</radius><length>3.16</length></cylinder></geometry></collision>
        <visual name="top_v"><pose>0 0 0.5 1.5708 0 0</pose><geometry><cylinder><radius>0.08</radius><length>3.16</length></cylinder></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Docking target marker on the seabed -->
    <model name="dock_marker">
      <static>true</static>
      <pose>40 0 -19.95 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><cylinder><radius>2</radius><length>0.1</length></cylinder></geometry>
          <material><ambient>1 0.4 0 1</ambient><diffuse>1 0.4 0 1</diffuse><emissive>0.3 0.1 0 1</emissive></material></visual>
      </link>
    </model>

  </world>
</sdf>
